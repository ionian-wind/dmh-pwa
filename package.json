{
  "name": "dmh-pwa",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "license": "MIT",
  "author": "",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "types-check": "npx vue-tsc --noEmit -p tsconfig.json",
    "test:watch": "vitest",
    "test": "vitest run --printConsoleTrace=true --silent=false",
    "test:regression": "vitest run tests/regressions --printConsoleTrace=true --silent=false",
    "test:ui": "vitest --ui --printConsoleTrace=true --silent=false",
    "test:coverage": "vitest run --printConsoleTrace=true --silent=false --coverage",
    "test:probability-calculator": "vitest run src/utils/dice-probability-calculator",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:install": "playwright install chromium firefox",
    "migration:generate": "node generate-migration.js",
    "pack:sound": "node scripts/pack-sound-pack.js",
    "unpack:sound": "node scripts/unpack-sound-pack.js",
    "postinstall": "patch-package",
    "format": "npm run hook:format",
    "lint": "npm run hook:lint \"{src,tools,test,migrations}/**/*.{js,jsx,mjs,cjs,ts,tsx,md,vue}\" --",
    "lint:fix": "npm run lint -- --fix",
    "hook:format": "npx prettier --ignore-path .gitignore --write \"{src,tools,test,migrations}/**/*.{js,jsx,mjs,cjs,ts,tsx,md,vue}\"",
    "hook:lint": "npx eslint --ignore-path .gitignore",
    "prepare": "husky",
    "commitlint": "commitlint --edit"
  },
  "dependencies": {
    "@3d-dice/dice-box": "1.1.4",
    "@3d-dice/dice-ui": "0.5.2",
    "@3d-dice/theme-default-extras": "0.1.1",
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@milkdown/crepe": "7.23.0",
    "@milkdown/kit": "7.23.0",
    "@milkdown/vue": "7.23.0",
    "@quasar/extras": "2.1.0",
    "@quickdrawjs/core": "0.3.0",
    "@tabler/icons-vue": "3.50.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue-dnd-kit/core": "1.7.0",
    "@vueuse/core": "15.0.0",
    "browserslist": "4.29.5",
    "buffer": "6.0.3",
    "chevrotain": "13.2.0",
    "howler": "2.2.4",
    "idb": "8.0.4",
    "jszip": "3.10.2",
    "markdown-it": "15.0.3",
    "mathjs": "15.2.0",
    "monaco-editor": "0.57.0",
    "music-metadata": "12.3.4",
    "nanoid": "6.0.2",
    "ol": "10.11.0",
    "ol-contextmenu": "6.0.1",
    "ol-ext": "4.0.38",
    "ol-marker-feature": "2.0.3",
    "patch-package": "8.0.1",
    "pinia": "4.1.0",
    "pinia-plugin-persistedstate": "4.7.1",
    "pinia-shared-state": "2.1.0",
    "quasar": "2.35.2",
    "remove-markdown": "0.8.0",
    "rpg-awesome": "0.2.0",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "slugify": "1.6.9",
    "terra-draw": "1.39.0",
    "terra-draw-openlayers-adapter": "1.3.0",
    "text-cursor-helper": "1.0.0",
    "unzipit": "2.0.0",
    "vue": "3.5.44",
    "vue-i18n": "11.4.18",
    "vue-router": "5.4.0",
    "vue3-charts": "2.2.0",
    "vue3-openlayers": "12.2.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@quasar/vite-plugin": "2.0.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/vue": "8.1.0",
    "@types/howler": "2.2.13",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.6",
    "@types/sanitize-html": "2.16.2",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/ui": "5.1.0",
    "@vue/test-utils": "2.5.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "commitlint": "21.2.4",
    "fake-indexeddb": "6.2.7",
    "happy-dom": "21.0.4",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "sass-embedded": "1.107.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
