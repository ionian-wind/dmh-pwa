    "@testing-library/vue": "8.1.0",
    "@types/howler": "2.2.13",
    "@types/markdown-it": "14.1.2",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.1",
    "@vitest/coverage-v8": "3.2.5",
    "@vitest/ui": "3.2.5",
    "@vue/test-utils": "2.4.10",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "commitlint": "21.0.2",
    "fake-indexeddb": "6.0.0",
    "happy-dom": "20.9.0",
