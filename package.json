{
  "name": "dmh-pwa",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "license": "MIT",
  "author": "",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "types-check": "npx tsc --project tsconfig.json --noEmit",
    "test:watch": "vitest",
    "test": "vitest run --printConsoleTrace=true --silent=false",
    "test:ui": "vitest --ui --printConsoleTrace=true --silent=false",
    "test:coverage": "vitest run --printConsoleTrace=true --silent=false --coverage",
    "migration:generate": "node generate-migration.js",
    "postinstall": "patch-package",
    "format": "npm run hook:format",
    "lint": "npm run hook:lint \"{src,tools,test,migrations}/**/*.{js,jsx,mjs,cjs,ts,tsx,md,vue}\" --",
    "lint:fix": "npm run lint -- --fix",
    "hook:format": "npx prettier --ignore-path .gitignore --write \"{src,tools,test,migrations}/**/*.{js,jsx,mjs,cjs,ts,tsx,md,vue}\"",
    "hook:lint": "npx eslint --ignore-path .gitignore",
    "prepare": "husky",
    "commitlint": "commitlint --edit"
  },
  "dependencies": {
    "@3d-dice/dice-box": "1.1.4",
    "@3d-dice/dice-ui": "0.5.2",
    "@3d-dice/theme-default-extras": "0.1.1",
    "@milkdown/crepe": "7.16.0",
    "@milkdown/kit": "7.16.0",
    "@milkdown/vue": "7.16.0",
    "@quasar/extras": "1.17.0",
    "@tabler/icons-vue": "3.35.0",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue-dnd-kit/components": "0.6.1",
    "@vue-dnd-kit/core": "1.7.0",
    "@vueuse/core": "13.9.0",
    "ajv": "8.17.1",
    "buffer": "6.0.3",
    "chevrotain": "11.0.3",
    "howler": "2.2.4",
    "idb": "8.0.3",
    "jszip": "3.10.1",
    "markdown-it": "14.1.0",
    "mathjs": "14.8.1",
    "music-metadata": "11.9.0",
    "nanoid": "5.1.6",
    "patch-package": "8.0.1",
    "pinia": "3.0.3",
    "pinia-plugin-persistedstate": "4.5.0",
    "pinia-shared-state": "1.0.1",
    "quasar": "2.18.5",
    "remove-markdown": "0.6.2",
    "rpg-awesome": "0.2.0",
    "sanitize-html": "2.17.0",
    "sharp": "0.34.4",
    "text-cursor-helper": "1.0.0",
    "vue": "3.5.22",
    "vue-i18n": "11.1.12",
    "vue-router": "4.5.1",
    "vuedraggable": "4.1.0"
  },
  "devDependencies": {
    "@quasar/vite-plugin": "1.10.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/vue": "8.1.0",
    "@types/howler": "2.2.12",
    "@types/markdown-it": "14.1.2",
    "@types/node": "22.18.8",
    "@types/sanitize-html": "2.16.0",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "3.2.4",
    "@vue/test-utils": "2.4.6",
    "commitlint": "20.1.0",
    "happy-dom": "20.0.0",
    "husky": "9.1.7",
    "jsdom": "27.0.0",
    "lint-staged": "16.2.3",
    "prettier": "3.6.2",
    "sass-embedded": "1.89.2",
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "vite-plugin-pwa": "1.0.3",
    "vitest": "3.2.4",
    "vue-tsc": "3.1.1"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
