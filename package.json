    "@milkdown/kit": "7.21.1",
    "@milkdown/vue": "7.21.1",
    "@quasar/extras": "1.17.0",
    "@tabler/icons-vue": "3.44.0",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue-dnd-kit/components": "0.6.1",
    "@vue-dnd-kit/core": "1.7.0",
    "@vueuse/core": "13.9.0",
    "browserslist": "4.28.2",
    "buffer": "6.0.3",
    "chevrotain": "12.0.0",
    "howler": "2.2.4",
    "idb": "8.0.3",
    "jszip": "3.10.1",
    "markdown-it": "14.2.0",
    "mathjs": "15.2.0",
    "music-metadata": "11.12.3",
