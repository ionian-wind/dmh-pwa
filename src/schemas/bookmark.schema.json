{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bookmark",
  "type": "object",
  "required": ["id", "noteId", "title", "createdAt", "updatedAt"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the bookmark"
    },
    "noteId": {
      "type": "string",
      "description": "Anchor ID of the heading/bookmark"
    },
    "title": {
      "type": "string",
      "description": "Title of the heading/bookmark"
    },
    "ownerKind": {
      "type": "string",
      "enum": ["note"],
      "description": "Entity kind that owns the bookmark"
    },
    "ownerId": {
      "type": "string",
      "description": "ID of the owning note"
    },
    "anchorId": {
      "type": "string",
      "description": "Anchor ID of the bookmarked heading or paragraph"
    },
    "createdAt": {
      "type": "number",
      "description": "Timestamp when the bookmark was created"
    },
    "updatedAt": {
      "type": "number",
      "description": "Timestamp when the bookmark was last updated"
    }
  }
}
