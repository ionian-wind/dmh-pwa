{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Note",
  "type": "object",
  "required": [
    "id",
    "title",
    "content",
    "contentType",
    "typeId",
    "tags",
    "createdAt",
    "updatedAt",
    "moduleIds"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the note"
    },
    "title": {
      "type": "string",
      "description": "Title of the note"
    },
    "content": {
      "type": "string",
      "description": "Markdown source or a Quickdraw snapshot JSON string"
    },
    "contentType": {
      "type": "string",
      "enum": ["text", "draw"],
      "description": "Note content kind"
    },
    "preview": {
      "type": "string",
      "description": "Small PNG data URL preview for drawing notes"
    },
    "typeId": {
      "oneOf": [
        {
          "type": "string",
          "description": "ID of the note type"
        },
        {
          "type": "null",
          "description": "No note type assigned"
        }
      ],
      "description": "ID of the note type or null if no type assigned"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of tags associated with the note"
    },
    "createdAt": {
      "type": "number",
      "description": "Timestamp when the note was created"
    },
    "updatedAt": {
      "type": "number",
      "description": "Timestamp when the note was last updated"
    },
    "moduleIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of the modules this note is linked to"
    }
  }
}
