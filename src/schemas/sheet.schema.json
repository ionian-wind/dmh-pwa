{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Sheet",
  "description": "A digital character sheet configuration",
  "required": ["id", "name", "createdAt", "updatedAt", "layout", "gameSystem"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the sheet"
    },
    "name": {
      "type": "string",
      "description": "Name of the character sheet"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes about the character sheet"
    },
    "createdAt": {
      "type": "number",
      "description": "Timestamp when the sheet was created"
    },
    "updatedAt": {
      "type": "number",
      "description": "Timestamp when the sheet was last updated"
    },
    "layout": {
      "type": "array",
      "description": "Array of layout items for the sheet",
      "items": {
        "type": "object",
        "required": ["id", "componentType", "x", "y", "width", "height", "properties"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the layout item"
          },
          "componentType": {
            "type": "string",
            "description": "Type of component to render"
          },
          "x": {
            "type": "number",
            "description": "X position in the grid"
          },
          "y": {
            "type": "number",
            "description": "Y position in the grid"
          },
          "width": {
            "type": "number",
            "description": "Width of the component in grid units"
          },
          "height": {
            "type": "number",
            "description": "Height of the component in grid units"
          },
          "properties": {
            "type": "object",
            "description": "Configuration properties for the component",
            "additionalProperties": true
          },
          "locked": {
            "type": "boolean",
            "description": "Whether the component is locked from editing"
          },
          "name": {
            "type": "string",
            "description": "User-friendly name for the component"
          }
        }
      }
    },
    "gameSystem": {
      "type": "string",
      "description": "Game system the sheet is designed for"
    },
    "sheetConfig": {
      "type": "object",
      "description": "Additional configuration specific to sheets",
      "additionalProperties": true
    },
    "characterId": {
      "type": "string",
      "description": "Optional link to existing character"
    }
  }
}