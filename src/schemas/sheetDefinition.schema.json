{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SheetDefinition",
  "type": "object",
  "required": ["id", "name", "layout", "createdAt", "updatedAt"],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "system": {
      "type": "string"
    },
    "layout": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "columns", "cells"],
        "properties": {
          "id": {
            "type": "string"
          },
          "columns": {
            "type": "number"
          },
          "cells": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "span"],
              "properties": {
                "id": {
                  "type": "string"
                },
                "span": {
                  "type": "number"
                },
                "component": {
                  "type": "object",
                  "required": ["id", "type", "props"],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "props": {
                      "type": "object"
                    },
                    "label": {
                      "type": "string"
                    },
                    "value": {}
                  }
                }
              }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object"
    },
    "createdAt": {
      "type": "number"
    },
    "updatedAt": {
      "type": "number"
    }
  }
}