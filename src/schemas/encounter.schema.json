{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Encounter",
  "type": "object",
  "required": ["id", "name", "pawns", "createdAt", "updatedAt"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the encounter"
    },
    "name": {
      "type": "string",
      "description": "Name of the encounter"
    },
    "description": {
      "type": "string",
      "description": "Description of the encounter"
    },
    "pawns": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 1,
        "maximum": 20
      },
      "description": "Object mapping monster IDs to their pawn counts in this encounter"
    },
    "createdAt": {
      "type": "number",
      "description": "Timestamp when the encounter was created"
    },
    "updatedAt": {
      "type": "number",
      "description": "Timestamp when the encounter was last updated"
    }
  }
}
