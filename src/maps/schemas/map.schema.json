{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Map",
  "type": "object",
  "required": [
    "id",
    "title",
    "createdAt",
    "updatedAt",
    "fileId",
    "locationId",
    "layers",
    "markers",
    "areas"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "createdAt": {
      "type": "number"
    },
    "updatedAt": {
      "type": "number"
    },
    "fileId": {
      "type": "string",
      "minLength": 1
    },
    "locationId": {
      "type": ["string", "null"]
    },
    "layers": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "locations": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["id", "name", "entities"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "entities": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/entityRef"
            }
          }
        }
      }
    },
    "markers": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "x",
          "y",
          "entities",
          "layerId",
          "icon",
          "color"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "locationId": {
            "type": ["string", "null"]
          },
          "layerId": {
            "type": "string"
          },
          "entities": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/entityRef"
            }
          },
          "icon": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "areas": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "shape",
          "points",
          "entities",
          "layerId",
          "color"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "shape": {
            "type": "string",
            "enum": ["polygon", "circle", "square", "freehand"]
          },
          "points": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "center": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "radius": {
            "type": "number"
          },
          "locationId": {
            "type": ["string", "null"]
          },
          "layerId": {
            "type": "string"
          },
          "entities": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/entityRef"
            }
          },
          "icon": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "definitions": {
    "entityRef": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "note",
            "module",
            "party",
            "monster",
            "encounter",
            "character",
            "map"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
