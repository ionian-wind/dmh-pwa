{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MapLocation",
  "type": "object",
  "required": ["id", "name", "entities", "createdAt", "updatedAt"],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/entityRef"
      }
    },
    "createdAt": {
      "type": "number"
    },
    "updatedAt": {
      "type": "number"
    }
  },
  "definitions": {
    "entityRef": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "note",
            "module",
            "party",
            "monster",
            "encounter",
            "character",
            "map"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
